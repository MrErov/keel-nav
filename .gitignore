# ==============================================================
# Keel Nav — .gitignore
# Repo is pure Markdown. Most entries below are defensive:
# they prevent accidental commits from contributors' local harnesses,
# IDE state, personal notes, and draft artifacts.
# ==============================================================

# --------------------------------------------------------------
# AI harness / LLM caches (per-tool, never committed)
# --------------------------------------------------------------
.opencode/
.claude/
.codex/
.cursor/
.aider*
.continue/
.gemini/
.dsh/
.agent/
.agents-local/

# Per-harness runtime state
*.session.json
*.chat.json
*.conversation.md
session-*.md

# Token accounting / cost logs
tokens.log
*.tokenlog
.token-usage
cost-*.csv

# --------------------------------------------------------------
# Editor / IDE state
# --------------------------------------------------------------
.vscode/*
!.vscode/settings.json.example
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.project
.classpath

# --------------------------------------------------------------
# OS noise
# --------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# --------------------------------------------------------------
# Drafts and in-progress artifacts (the Navigator's workspace)
# These are NOT part of the methodology; they are scratch.
# --------------------------------------------------------------
drafts/
scratch/
notes/
*.draft.md
*.wip.md
*.local.md
*.private.md
PERSONAL_*
TODO.local.md

# Generated specs that have NOT passed the Goldfish Audit gate
# (move to specs/ only after gate G1..G7 pass)
specs/*.draft.spec.md
specs/*.pre-audit.spec.md
specs/*.unaudited.spec.md

# Drift reports before certification
docs/drift/*.draft.md

# --------------------------------------------------------------
# Build / dist (defensive — repo has no build step)
# --------------------------------------------------------------
node_modules/
dist/
build/
out/
target/
*.pyc
__pycache__/
.venv/
venv/
.env
.env.local

# --------------------------------------------------------------
# Test artifacts (defensive — repo has no test suite)
# --------------------------------------------------------------
coverage/
.nyc_output/
*.log
test-results/
.pytest_cache/
.ruff_cache/

# --------------------------------------------------------------
# Keep directory placeholders
# --------------------------------------------------------------
!**/.gitkeep
